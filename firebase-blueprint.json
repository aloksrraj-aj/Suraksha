{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated responder profile and active organization pointer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "callsign": { "type": "string" },
        "activeOrgId": { "type": "string" },
        "teamId": { "type": "string" },
        "teamName": { "type": "string" },
        "role": { "type": "string", "enum": ["org_admin", "team_leader", "operator", "medic", "observer", "coordinator"] },
        "locationSharingEnabled": { "type": "boolean" },
        "backgroundTrackingEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "callsign", "activeOrgId", "teamId", "teamName", "role", "locationSharingEnabled", "backgroundTrackingEnabled", "createdAt", "updatedAt"]
    },
    "RescueOrganization": {
      "title": "RescueOrganization",
      "description": "Multi-tenant rescue organization workspace.",
      "type": "object",
      "properties": {
        "orgCode": { "type": "string" },
        "orgName": { "type": "string" },
        "region": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgCode", "orgName", "region", "createdByUid", "createdAt", "updatedAt"]
    },
    "OrgInvite": {
      "title": "OrgInvite",
      "description": "Secure organization join invitation code.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "inviteCode": { "type": "string" },
        "defaultRole": { "type": "string", "enum": ["operator", "observer"] },
        "active": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "inviteCode", "defaultRole", "active", "createdByUid", "createdAt", "updatedAt"]
    },
    "OrgMember": {
      "title": "OrgMember",
      "description": "Organization membership and RBAC role assignment.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orgId": { "type": "string" },
        "displayName": { "type": "string" },
        "callsign": { "type": "string" },
        "role": { "type": "string", "enum": ["org_admin", "team_leader", "operator", "medic", "observer"] },
        "teamId": { "type": "string" },
        "availability": { "type": "string", "enum": ["available", "deployed", "standby", "offline"] },
        "inviteCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "orgId", "displayName", "callsign", "role", "teamId", "availability", "inviteCode", "createdAt", "updatedAt"]
    },
    "RescueTeam": {
      "title": "RescueTeam",
      "description": "Rescue team unit with voluntary GPS tracking, accuracy, and status.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "userId": { "type": "string" },
        "leaderUid": { "type": "string" },
        "teamCode": { "type": "string" },
        "teamName": { "type": "string" },
        "memberCount": { "type": "integer" },
        "activeCount": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "deployed", "standby", "offline"] },
        "locationSharingOptIn": { "type": "boolean" },
        "hasValidLocation": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracyMeters": { "type": "number" },
        "locationTimestampMillis": { "type": "integer" },
        "locationUnavailableReason": { "type": "string" },
        "batteryPercent": { "type": "integer" },
        "connectionStatus": { "type": "string", "enum": ["online", "offline", "stale", "low_bandwidth"] },
        "isSynthetic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "userId", "leaderUid", "teamCode", "teamName", "memberCount", "activeCount", "status", "locationSharingOptIn", "hasValidLocation", "latitude", "longitude", "accuracyMeters", "locationTimestampMillis", "locationUnavailableReason", "batteryPercent", "connectionStatus", "isSynthetic", "createdAt", "updatedAt"]
    },
    "RescueLocation": {
      "title": "RescueLocation",
      "description": "Disaster site and operational boundary.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": "string" },
        "hazardType": { "type": "string", "enum": ["earthquake", "flood", "landslide", "structural_collapse", "other"] },
        "severity": { "type": "string", "enum": ["critical", "high", "moderate", "low"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radiusMeters": { "type": "number" },
        "verificationStatus": { "type": "string", "enum": ["verified", "estimated", "unverified", "outdated"] },
        "dataSource": { "type": "string" },
        "isSynthetic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "userId", "name", "region", "hazardType", "severity", "latitude", "longitude", "radiusMeters", "verificationStatus", "dataSource", "isSynthetic", "createdAt", "updatedAt"]
    },
    "PresenceSignal": {
      "title": "PresenceSignal",
      "description": "Human presence sensor detection separating simulated vs hardware and estimated vs verified.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "userId": { "type": "string" },
        "locationId": { "type": "string" },
        "sectorLabel": { "type": "string" },
        "signalType": { "type": "string", "enum": ["thermal_ir", "radar_respiration", "acoustic_vibration", "co2_plume", "lidar_void"] },
        "sourceKind": { "type": "string", "enum": ["simulated", "hardware"] },
        "deviceId": { "type": "string" },
        "calibrationStatus": { "type": "string", "enum": ["calibrated", "needs_calibration", "nominal", "unknown"] },
        "sensorHealth": { "type": "string", "enum": ["healthy", "degraded", "error", "offline"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "hasCoordinates": { "type": "boolean" },
        "estimatedMinCount": { "type": "integer" },
        "estimatedMaxCount": { "type": "integer" },
        "confidencePercent": { "type": "integer" },
        "verificationStatus": { "type": "string", "enum": ["estimated", "unverified", "field_verified", "outdated"] },
        "dataSource": { "type": "string" },
        "verifiedByUid": { "type": "string" },
        "verificationNotes": { "type": "string" },
        "observationTimestampMillis": { "type": "integer" },
        "isSynthetic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "userId", "locationId", "sectorLabel", "signalType", "sourceKind", "deviceId", "calibrationStatus", "sensorHealth", "latitude", "longitude", "hasCoordinates", "estimatedMinCount", "estimatedMaxCount", "confidencePercent", "verificationStatus", "dataSource", "verifiedByUid", "verificationNotes", "observationTimestampMillis", "isSynthetic", "createdAt", "updatedAt"]
    },
    "RescueRegistryEntry": {
      "title": "RescueRegistryEntry",
      "description": "Rescue registry record with 6 verification levels and PII controls.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string", "enum": ["missing_person", "verified_survivor", "medical_request", "disaster_site"] },
        "title": { "type": "string" },
        "locationName": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "hasCoordinates": { "type": "boolean" },
        "details": { "type": "string" },
        "sensitiveContactMasked": { "type": "string" },
        "photoUriLocal": { "type": "string" },
        "photoConsentGranted": { "type": "boolean" },
        "rescueStatus": { "type": "string", "enum": ["open", "dispatched", "in_progress", "resolved"] },
        "verificationStatus": { "type": "string", "enum": ["reported", "under_verification", "verified", "unverified", "duplicate", "resolved"] },
        "informationSource": { "type": "string" },
        "verifierUid": { "type": "string" },
        "verificationNotes": { "type": "string" },
        "duplicateOfId": { "type": "string" },
        "isSynthetic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "userId", "category", "title", "locationName", "latitude", "longitude", "hasCoordinates", "details", "sensitiveContactMasked", "photoUriLocal", "photoConsentGranted", "rescueStatus", "verificationStatus", "informationSource", "verifierUid", "verificationNotes", "duplicateOfId", "isSynthetic", "createdAt", "updatedAt"]
    },
    "SosIncident": {
      "title": "SosIncident",
      "description": "Emergency SOS incident with full lifecycle states and audit tracking.",
      "type": "object",
      "properties": {
        "incidentId": { "type": "string" },
        "orgId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "teamCode": { "type": "string" },
        "priority": { "type": "string", "enum": ["sos", "urgent", "routine"] },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["created", "pending_delivery", "delivered", "acknowledged", "team_assigned", "responding", "resolved", "closed", "failed"] },
        "hasLocation": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracyMeters": { "type": "number" },
        "assignedTeamId": { "type": "string" },
        "assignedTeamCode": { "type": "string" },
        "acknowledgedByUid": { "type": "string" },
        "acknowledgedAtMillis": { "type": "integer" },
        "deliveryNote": { "type": "string" },
        "isSynthetic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["incidentId", "orgId", "senderUid", "senderName", "teamCode", "priority", "description", "status", "hasLocation", "latitude", "longitude", "accuracyMeters", "assignedTeamId", "assignedTeamCode", "acknowledgedByUid", "acknowledgedAtMillis", "deliveryNote", "isSynthetic", "createdAt", "updatedAt"]
    },
    "SosAuditLog": {
      "title": "SosAuditLog",
      "description": "Append-only SOS incident state transition log.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "incidentId": { "type": "string" },
        "actorUid": { "type": "string" },
        "fromStatus": { "type": "string" },
        "toStatus": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "incidentId", "actorUid", "fromStatus", "toStatus", "note", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated responder profile."
    },
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/RescueOrganization" },
      "description": "Rescue organization workspace."
    },
    "/organizations/{orgId}/invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/OrgInvite" },
      "description": "Invite codes for joining an organization."
    },
    "/organizations/{orgId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/OrgMember" },
      "description": "Organization member RBAC records."
    },
    "/organizations/{orgId}/teams/{teamId}": {
      "schema": { "$ref": "#/entities/RescueTeam" },
      "description": "Organization rescue teams."
    },
    "/organizations/{orgId}/locations/{locationId}": {
      "schema": { "$ref": "#/entities/RescueLocation" },
      "description": "Organization disaster sites."
    },
    "/organizations/{orgId}/presence_signals/{signalId}": {
      "schema": { "$ref": "#/entities/PresenceSignal" },
      "description": "Sensor human-presence detections."
    },
    "/organizations/{orgId}/registry/{entryId}": {
      "schema": { "$ref": "#/entities/RescueRegistryEntry" },
      "description": "Organization rescue registry."
    },
    "/organizations/{orgId}/sos_incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/SosIncident" },
      "description": "Organization SOS emergency incidents."
    },
    "/organizations/{orgId}/sos_incidents/{incidentId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/SosAuditLog" },
      "description": "Append-only SOS audit history."
    }
  }
}
