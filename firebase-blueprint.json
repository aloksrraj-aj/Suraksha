{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated responder profile and active workspace pointers.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "phoneOptional": { "type": "string" },
        "callsign": { "type": "string" },
        "activeOrgId": { "type": "string" },
        "activeTeamId": { "type": "string" },
        "activeMissionId": { "type": "string" },
        "locationSharingEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "email", "photoUrl", "phoneOptional", "callsign", "activeOrgId", "activeTeamId", "activeMissionId", "locationSharingEnabled", "createdAt", "updatedAt"]
    },
    "RescueOrganization": {
      "title": "RescueOrganization",
      "description": "Rescue organization controlling member invitation policies and teams.",
      "type": "object",
      "properties": {
        "orgCode": { "type": "string" },
        "orgName": { "type": "string" },
        "region": { "type": "string" },
        "allowMemberInvites": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgCode", "orgName", "region", "allowMemberInvites", "createdByUid", "createdAt", "updatedAt"]
    },
    "OrgMember": {
      "title": "OrgMember",
      "description": "Organization member record with RBAC role and REVOKED enforcement.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orgId": { "type": "string" },
        "displayName": { "type": "string" },
        "callsign": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["ORGANIZATION_ADMIN", "TEAM_ADMIN", "TEAM_MEMBER", "SENSOR_OPERATOR"] },
        "teamId": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "REVOKED"] },
        "availability": { "type": "string", "enum": ["available", "deployed", "standby", "offline"] },
        "inviteCode": { "type": "string" },
        "revokedByUid": { "type": "string" },
        "revokedAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "orgId", "displayName", "callsign", "photoUrl", "role", "teamId", "status", "availability", "inviteCode", "revokedByUid", "revokedAtMillis", "createdAt", "updatedAt"]
    },
    "BlockedMembership": {
      "title": "BlockedMembership",
      "description": "Server-enforced block list preventing removed users from rejoining without Admin reinstatement.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orgId": { "type": "string" },
        "teamId": { "type": "string" },
        "missionId": { "type": "string" },
        "blockedByUid": { "type": "string" },
        "reason": { "type": "string" },
        "blockedEmailNormalized": { "type": "string" },
        "blockedAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "orgId", "teamId", "missionId", "blockedByUid", "reason", "blockedEmailNormalized", "blockedAtMillis", "createdAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Expiring, limited-use invitation token supporting admin approval workflow.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "inviteCode": { "type": "string" },
        "assignedRole": { "type": "string", "enum": ["TEAM_MEMBER", "SENSOR_OPERATOR"] },
        "targetTeamId": { "type": "string" },
        "targetMissionId": { "type": "string" },
        "targetEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_approval", "approved", "rejected", "revoked"] },
        "active": { "type": "boolean" },
        "expiresAtMillis": { "type": "integer" },
        "maxUses": { "type": "integer" },
        "usedCount": { "type": "integer" },
        "createdByUid": { "type": "string" },
        "createdByRole": { "type": "string" },
        "approvedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "inviteCode", "assignedRole", "targetTeamId", "targetMissionId", "targetEmail", "status", "active", "expiresAtMillis", "maxUses", "usedCount", "createdByUid", "createdByRole", "approvedByUid", "createdAt", "updatedAt"]
    },
    "RescueTeam": {
      "title": "RescueTeam",
      "description": "Rescue team configuration and admin ownership.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "teamCode": { "type": "string" },
        "teamName": { "type": "string" },
        "teamAdminUid": { "type": "string" },
        "allowMemberInvites": { "type": "boolean" },
        "memberCount": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "deployed", "standby", "archived"] },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "teamCode", "teamName", "teamAdminUid", "allowMemberInvites", "memberCount", "status", "createdByUid", "createdAt", "updatedAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Team-level membership with ACTIVE/REVOKED tracking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orgId": { "type": "string" },
        "teamId": { "type": "string" },
        "displayName": { "type": "string" },
        "callsign": { "type": "string" },
        "role": { "type": "string", "enum": ["ORGANIZATION_ADMIN", "TEAM_ADMIN", "TEAM_MEMBER", "SENSOR_OPERATOR"] },
        "status": { "type": "string", "enum": ["ACTIVE", "REVOKED"] },
        "revokedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "orgId", "teamId", "displayName", "callsign", "role", "status", "revokedByUid", "createdAt", "updatedAt"]
    },
    "Mission": {
      "title": "Mission",
      "description": "Shared operational rescue mission supporting Building (UWB) or Open Area (FMCW) modes.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string" },
        "orgId": { "type": "string" },
        "teamId": { "type": "string" },
        "teamCode": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "environmentMode": { "type": "string", "enum": ["BUILDING_COLLAPSED", "OPEN_AREA"] },
        "status": { "type": "string", "enum": ["created", "ready", "active", "paused", "completed", "cancelled"] },
        "separationAlertEnabled": { "type": "boolean" },
        "separationThresholdMeters": { "type": "number" },
        "separationDelaySeconds": { "type": "integer" },
        "centerLatitude": { "type": "number" },
        "centerLongitude": { "type": "number" },
        "leaderUid": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "orgId", "teamId", "teamCode", "title", "description", "environmentMode", "status", "separationAlertEnabled", "separationThresholdMeters", "separationDelaySeconds", "centerLatitude", "centerLongitude", "leaderUid", "createdByUid", "createdAt", "updatedAt"]
    },
    "MissionMember": {
      "title": "MissionMember",
      "description": "Authorized mission participant membership and sharing state.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orgId": { "type": "string" },
        "missionId": { "type": "string" },
        "teamId": { "type": "string" },
        "displayName": { "type": "string" },
        "callsign": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["ORGANIZATION_ADMIN", "TEAM_ADMIN", "TEAM_MEMBER", "SENSOR_OPERATOR"] },
        "status": { "type": "string", "enum": ["ACTIVE", "LEFT", "REVOKED"] },
        "sharingEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "orgId", "missionId", "teamId", "displayName", "callsign", "photoUrl", "role", "status", "sharingEnabled", "createdAt", "updatedAt"]
    },
    "MemberLocation": {
      "title": "MemberLocation",
      "description": "Authorized mission member real-time GPS location and telemetry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orgId": { "type": "string" },
        "missionId": { "type": "string" },
        "teamId": { "type": "string" },
        "displayName": { "type": "string" },
        "callsign": { "type": "string" },
        "role": { "type": "string" },
        "sharingEnabled": { "type": "boolean" },
        "hasValidLocation": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracyMeters": { "type": "number" },
        "headingDegrees": { "type": "number" },
        "headingReliable": { "type": "boolean" },
        "batteryPercent": { "type": "integer" },
        "connectionStatus": { "type": "string", "enum": ["online", "offline", "stale", "gps_disabled", "permission_denied", "paused"] },
        "locationTimestampMillis": { "type": "integer" },
        "unavailableReason": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "orgId", "missionId", "teamId", "displayName", "callsign", "role", "sharingEnabled", "hasValidLocation", "latitude", "longitude", "accuracyMeters", "headingDegrees", "headingReliable", "batteryPercent", "connectionStatus", "locationTimestampMillis", "unavailableReason", "updatedAt"]
    },
    "SensorDevice": {
      "title": "SensorDevice",
      "description": "External hardware sensor registration and orientation for rescue radar.",
      "type": "object",
      "properties": {
        "sensorId": { "type": "string" },
        "orgId": { "type": "string" },
        "missionId": { "type": "string" },
        "sensorType": { "type": "string", "enum": ["uwb_life_detection_radar", "fmcw_radar", "thermal_imaging", "acoustic_vibration", "registered_ble_tag", "uwb_ranging_tag"] },
        "displayName": { "type": "string" },
        "manufacturerModel": { "type": "string" },
        "transportType": { "type": "string", "enum": ["gateway_http_tls", "gateway_ws_tls", "gateway_mqtt_tls", "manufacturer_sdk_pending", "ble_registered_tag"] },
        "connectionStatus": { "type": "string", "enum": ["awaiting_integration", "connecting", "connected", "disconnected", "error"] },
        "hasPosition": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "orientationDegrees": { "type": "number" },
        "sectorWidthDegrees": { "type": "number" },
        "maxRangeMeters": { "type": "number" },
        "calibrationVersion": { "type": "string" },
        "lastCalibrationMillis": { "type": "integer" },
        "operatorUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sensorId", "orgId", "missionId", "sensorType", "displayName", "manufacturerModel", "transportType", "connectionStatus", "hasPosition", "latitude", "longitude", "orientationDegrees", "sectorWidthDegrees", "maxRangeMeters", "calibrationVersion", "lastCalibrationMillis", "operatorUid", "updatedAt"]
    },
    "SensorEvent": {
      "title": "SensorEvent",
      "description": "Normalized external sensor detection event (never fabricated; optional hardware values nullable).",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "orgId": { "type": "string" },
        "missionId": { "type": "string" },
        "sensorId": { "type": "string" },
        "sensorType": { "type": "string" },
        "timestampUtcMillis": { "type": "integer" },
        "detectionType": { "type": "string" },
        "estimatedRangeMeters": { "type": "number" },
        "estimatedAzimuthDegrees": { "type": "number" },
        "estimatedElevationDegrees": { "type": "number" },
        "estimatedLatitude": { "type": "number" },
        "estimatedLongitude": { "type": "number" },
        "positionAccuracyMeters": { "type": "number" },
        "confidence": { "type": "number" },
        "signalQuality": { "type": "string", "enum": ["good", "fair", "poor", "unusable"] },
        "detectionDurationSeconds": { "type": "number" },
        "respirationRateBpm": { "type": "number" },
        "sourceDevice": { "type": "string" },
        "calibrationVersion": { "type": "string" },
        "rawDataReference": { "type": "string" },
        "dataValidity": { "type": "string", "enum": ["valid", "low_confidence", "stale", "uncertain"] },
        "status": { "type": "string", "enum": ["active", "stale", "reviewed", "cleared"] },
        "operatorUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "orgId", "missionId", "sensorId", "sensorType", "timestampUtcMillis", "detectionType", "confidence", "signalQuality", "sourceDevice", "calibrationVersion", "rawDataReference", "dataValidity", "status", "operatorUid", "createdAt"]
    },
    "SensorHealth": {
      "title": "SensorHealth",
      "description": "Live health, heartbeat, and packet integrity metrics for external sensor stations.",
      "type": "object",
      "properties": {
        "sensorId": { "type": "string" },
        "orgId": { "type": "string" },
        "missionId": { "type": "string" },
        "healthState": { "type": "string", "enum": ["healthy", "degraded", "offline", "error", "awaiting_integration"] },
        "lastHeartbeatMillis": { "type": "integer" },
        "packetsReceived": { "type": "integer" },
        "packetsRejected": { "type": "integer" },
        "diagnosticNote": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sensorId", "orgId", "missionId", "healthState", "lastHeartbeatMillis", "packetsReceived", "packetsRejected", "diagnosticNote", "updatedAt"]
    },
    "DetectionObservation": {
      "title": "DetectionObservation",
      "description": "Operator-reviewed field note linked to an unclassified possible human-presence sensor event.",
      "type": "object",
      "properties": {
        "detectionId": { "type": "string" },
        "orgId": { "type": "string" },
        "missionId": { "type": "string" },
        "sensorEventId": { "type": "string" },
        "sensorId": { "type": "string" },
        "operatorUid": { "type": "string" },
        "classificationLabel": { "type": "string" },
        "notes": { "type": "string" },
        "outcome": { "type": "string", "enum": ["unverified_observation", "investigating", "confirmed_clear", "rescue_requested"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["detectionId", "orgId", "missionId", "sensorEventId", "sensorId", "operatorUid", "classificationLabel", "notes", "outcome", "createdAt", "updatedAt"]
    },
    "SosAlert": {
      "title": "SosAlert",
      "description": "Emergency SOS or team separation alert with server delivery and cancellation audit.",
      "type": "object",
      "properties": {
        "alertId": { "type": "string" },
        "orgId": { "type": "string" },
        "missionId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "teamId": { "type": "string" },
        "alertType": { "type": "string", "enum": ["sos", "separation_alert"] },
        "priority": { "type": "string", "enum": ["critical", "urgent"] },
        "status": { "type": "string", "enum": ["active", "acknowledged", "responding", "resolved", "cancelled"] },
        "hasLocation": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracyMeters": { "type": "number" },
        "locationTimestampMillis": { "type": "integer" },
        "description": { "type": "string" },
        "acknowledgedByUid": { "type": "string" },
        "acknowledgedAtMillis": { "type": "integer" },
        "cancelledByUid": { "type": "string" },
        "cancelReason": { "type": "string" },
        "notificationStatus": { "type": "string" },
        "deliveryNote": { "type": "string" },
        "pushAttemptedCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["alertId", "orgId", "missionId", "senderUid", "senderName", "teamId", "alertType", "priority", "status", "hasLocation", "latitude", "longitude", "accuracyMeters", "locationTimestampMillis", "description", "acknowledgedByUid", "acknowledgedAtMillis", "cancelledByUid", "cancelReason", "notificationStatus", "deliveryNote", "pushAttemptedCount", "createdAt", "updatedAt"]
    },
    "GatewayDevice": {
      "title": "GatewayDevice",
      "description": "Registered Edge Gateway / Sensor Hub connection record.",
      "type": "object",
      "properties": {
        "gatewayId": { "type": "string" },
        "orgId": { "type": "string" },
        "name": { "type": "string" },
        "transportType": { "type": "string", "enum": ["http_tls", "websocket_tls", "mqtt_tls"] },
        "endpointUri": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "degraded", "offline", "unverified"] },
        "bufferedEventCount": { "type": "integer" },
        "lastHeartbeatMillis": { "type": "integer" },
        "registeredByUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gatewayId", "orgId", "name", "transportType", "endpointUri", "status", "bufferedEventCount", "lastHeartbeatMillis", "registeredByUid", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and operational audit trail.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "missionId": { "type": "string" },
        "teamId": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "category": { "type": "string", "enum": ["membership", "removal", "reinstatement", "invite", "role", "mission", "sos", "sensor", "gateway"] },
        "action": { "type": "string" },
        "targetUid": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "missionId", "teamId", "actorUid", "actorName", "category", "action", "targetUid", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated authenticated responder profile."
    },
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/RescueOrganization" },
      "description": "Rescue organization workspace."
    },
    "/organizations/{orgId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/OrgMember" },
      "description": "Organization member roles and REVOKED status."
    },
    "/organizations/{orgId}/blockedMemberships/{targetUid}": {
      "schema": { "$ref": "#/entities/BlockedMembership" },
      "description": "Admin-enforced blocked user registry."
    },
    "/organizations/{orgId}/invitations/{invitationId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Expiring invitations with member invite toggle and admin approval."
    },
    "/organizations/{orgId}/teams/{teamId}": {
      "schema": { "$ref": "#/entities/RescueTeam" },
      "description": "Rescue teams."
    },
    "/organizations/{orgId}/teams/{teamId}/teamMembers/{memberUid}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Team members."
    },
    "/organizations/{orgId}/teams/{teamId}/blockedMemberships/{targetUid}": {
      "schema": { "$ref": "#/entities/BlockedMembership" },
      "description": "Team-level blocked membership records."
    },
    "/organizations/{orgId}/missions/{missionId}": {
      "schema": { "$ref": "#/entities/Mission" },
      "description": "Shared rescue mission records."
    },
    "/organizations/{orgId}/missions/{missionId}/missionMembers/{memberUid}": {
      "schema": { "$ref": "#/entities/MissionMember" },
      "description": "Authorized mission members."
    },
    "/organizations/{orgId}/missions/{missionId}/blockedMemberships/{targetUid}": {
      "schema": { "$ref": "#/entities/BlockedMembership" },
      "description": "Mission-level blocked membership records."
    },
    "/organizations/{orgId}/missions/{missionId}/locations/{memberUid}": {
      "schema": { "$ref": "#/entities/MemberLocation" },
      "description": "Authorized mission member real-time GPS updates."
    },
    "/organizations/{orgId}/missions/{missionId}/sensorDevices/{sensorId}": {
      "schema": { "$ref": "#/entities/SensorDevice" },
      "description": "Mission external sensor registrations."
    },
    "/organizations/{orgId}/missions/{missionId}/sensorHealth/{sensorId}": {
      "schema": { "$ref": "#/entities/SensorHealth" },
      "description": "External sensor health and heartbeats."
    },
    "/organizations/{orgId}/missions/{missionId}/sensorEvents/{eventId}": {
      "schema": { "$ref": "#/entities/SensorEvent" },
      "description": "Validated unclassified sensor detection events."
    },
    "/organizations/{orgId}/missions/{missionId}/detections/{detectionId}": {
      "schema": { "$ref": "#/entities/DetectionObservation" },
      "description": "Operator observation notes linked to sensor events."
    },
    "/organizations/{orgId}/missions/{missionId}/sosAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/SosAlert" },
      "description": "Emergency SOS and team separation alerts."
    },
    "/organizations/{orgId}/gatewayDevices/{gatewayId}": {
      "schema": { "$ref": "#/entities/GatewayDevice" },
      "description": "Registered Edge Gateways / Sensor Hubs."
    },
    "/organizations/{orgId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable operational and membership audit trail."
    }
  }
}
