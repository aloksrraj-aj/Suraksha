rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time + duration.value(60, 's');
    }

    function isValidLatLon(lat, lon) {
      return lat is number && lat >= -90 && lat <= 90 &&
             lon is number && lon >= -180 && lon <= 180;
    }

    function hasVerifiedEmail() {
      return isSignedIn() &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.size() > 0;
    }

    function normalizedTokenEmail() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }

    function isBlockedEmail(orgId) {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/blockedEmails/$(normalizedTokenEmail()));
    }

    function isBlockedUser(orgId, uid) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/blockedMemberships/$(uid)) ||
        isBlockedEmail(orgId);
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function memberData(orgId) {
      return get(memberPath(orgId, request.auth.uid)).data;
    }

    function isActiveOrgMember(orgId) {
      return isSignedIn() &&
        !isBlockedUser(orgId, request.auth.uid) &&
        exists(memberPath(orgId, request.auth.uid)) &&
        memberData(orgId).status == 'ACTIVE';
    }

    function memberRole(orgId) {
      return memberData(orgId).role;
    }

    function hasAdminRole(orgId) {
      return memberRole(orgId) in ['ORGANIZATION_ADMIN', 'TEAM_ADMIN'];
    }

    function hasSensorRole(orgId) {
      return memberRole(orgId) in ['ORGANIZATION_ADMIN', 'TEAM_ADMIN', 'SENSOR_OPERATOR'];
    }

    function isOrgAdmin(orgId) {
      return isActiveOrgMember(orgId) && memberRole(orgId) == 'ORGANIZATION_ADMIN';
    }

    function isTeamOrOrgAdmin(orgId) {
      return isActiveOrgMember(orgId) && hasAdminRole(orgId);
    }

    function isSensorAuthorized(orgId) {
      return isActiveOrgMember(orgId) && hasSensorRole(orgId);
    }

    function orgAllowMemberInvites(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.allowMemberInvites == true;
    }

    function missionPath(orgId, missionId) {
      return /databases/$(database)/documents/organizations/$(orgId)/missions/$(missionId);
    }

    function missionMemberPath(orgId, missionId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/missions/$(missionId)/missionMembers/$(uid);
    }

    function isMissionBlocked(orgId, missionId, uid) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/missions/$(missionId)/blockedMemberships/$(uid));
    }

    function isMissionParticipant(orgId, missionId) {
      return isActiveOrgMember(orgId) &&
        !isMissionBlocked(orgId, missionId, request.auth.uid) &&
        exists(missionMemberPath(orgId, missionId, request.auth.uid)) &&
        get(missionMemberPath(orgId, missionId, request.auth.uid)).data.status == 'ACTIVE';
    }

    function isTeamBlocked(orgId, teamId, uid) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/teams/$(teamId)/blockedMemberships/$(uid));
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() <= 160 &&
        data.photoUrl is string && data.photoUrl.size() <= 512 &&
        data.phoneOptional is string && data.phoneOptional.size() <= 32 &&
        data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 32 &&
        data.activeOrgId is string && data.activeOrgId.size() <= 128 &&
        data.activeTeamId is string && data.activeTeamId.size() <= 128 &&
        data.activeMissionId is string && data.activeMissionId.size() <= 128 &&
        data.locationSharingEnabled is bool;
    }

    function isValidUserDeviceToken(data, userId, deviceId) {
      return data.userId == userId &&
        data.deviceId == deviceId &&
        data.fcmToken is string && data.fcmToken.size() >= 10 && data.fcmToken.size() <= 512 &&
        data.orgId is string && data.orgId.size() <= 128 &&
        data.notificationsEnabled is bool &&
        data.platform == 'android';
    }

    function isValidOrganization(data) {
      return data.orgCode is string && data.orgCode.size() >= 2 && data.orgCode.size() <= 32 &&
        data.orgName is string && data.orgName.size() >= 2 && data.orgName.size() <= 100 &&
        data.region is string && data.region.size() >= 1 && data.region.size() <= 80 &&
        data.allowMemberInvites is bool &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128;
    }

    function isValidOrgMember(data, orgId, memberUid) {
      return data.userId == memberUid &&
        data.orgId == orgId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 32 &&
        data.photoUrl is string && data.photoUrl.size() <= 512 &&
        data.role in ['ORGANIZATION_ADMIN', 'TEAM_ADMIN', 'TEAM_MEMBER', 'SENSOR_OPERATOR'] &&
        data.teamId is string && data.teamId.size() <= 128 &&
        data.status in ['ACTIVE', 'REVOKED'] &&
        data.availability in ['available', 'deployed', 'standby', 'offline'] &&
        data.inviteCode is string && data.inviteCode.size() <= 64 &&
        data.revokedByUid is string && data.revokedByUid.size() <= 128 &&
        data.revokedAtMillis is int && data.revokedAtMillis >= 0;
    }

    function isValidBlockedMembership(data, orgId, targetUid) {
      return data.userId == targetUid &&
        data.orgId == orgId &&
        data.teamId is string && data.teamId.size() <= 128 &&
        data.missionId is string && data.missionId.size() <= 128 &&
        data.blockedByUid is string && data.blockedByUid.size() >= 1 && data.blockedByUid.size() <= 128 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
        data.blockedEmailNormalized is string && data.blockedEmailNormalized.size() <= 160 &&
        data.blockedAtMillis is int && data.blockedAtMillis > 0;
    }

    function isValidInvitation(data, orgId) {
      return data.orgId == orgId &&
        data.inviteCode is string && data.inviteCode.size() >= 8 && data.inviteCode.size() <= 64 &&
        data.assignedRole in ['TEAM_MEMBER', 'SENSOR_OPERATOR'] &&
        data.targetTeamId is string && data.targetTeamId.size() <= 128 &&
        data.targetMissionId is string && data.targetMissionId.size() <= 128 &&
        data.targetEmail is string && data.targetEmail.size() <= 160 &&
        data.status in ['pending_approval', 'approved', 'rejected', 'revoked'] &&
        data.active is bool &&
        data.expiresAtMillis is int && data.expiresAtMillis > 0 &&
        data.maxUses is int && data.maxUses >= 1 && data.maxUses <= 500 &&
        data.usedCount is int && data.usedCount >= 0 && data.usedCount <= data.maxUses &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
        data.createdByRole is string && data.createdByRole.size() <= 32 &&
        data.approvedByUid is string && data.approvedByUid.size() <= 128;
    }

    function isValidRescueTeam(data, orgId) {
      return data.orgId == orgId &&
        data.teamCode is string && data.teamCode.size() >= 1 && data.teamCode.size() <= 32 &&
        data.teamName is string && data.teamName.size() >= 1 && data.teamName.size() <= 80 &&
        data.teamAdminUid is string && data.teamAdminUid.size() >= 1 && data.teamAdminUid.size() <= 128 &&
        data.allowMemberInvites is bool &&
        data.memberCount is int && data.memberCount >= 0 && data.memberCount <= 500 &&
        data.status in ['active', 'deployed', 'standby', 'archived'] &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128;
    }

    function isValidTeamMember(data, orgId, teamId, memberUid) {
      return data.userId == memberUid &&
        data.orgId == orgId &&
        data.teamId == teamId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 32 &&
        data.role in ['ORGANIZATION_ADMIN', 'TEAM_ADMIN', 'TEAM_MEMBER', 'SENSOR_OPERATOR'] &&
        data.status in ['ACTIVE', 'REVOKED'] &&
        data.revokedByUid is string && data.revokedByUid.size() <= 128;
    }

    function isValidMission(data, orgId, missionId) {
      return data.missionId == missionId &&
        data.orgId == orgId &&
        data.teamId is string && data.teamId.size() <= 128 &&
        data.teamCode is string && data.teamCode.size() <= 32 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.description is string && data.description.size() <= 500 &&
        data.environmentMode in ['BUILDING_COLLAPSED', 'OPEN_AREA'] &&
        data.status in ['created', 'ready', 'active', 'paused', 'completed', 'cancelled'] &&
        data.separationAlertEnabled is bool &&
        data.separationThresholdMeters is number && data.separationThresholdMeters >= 10 && data.separationThresholdMeters <= 10000 &&
        data.separationDelaySeconds is int && data.separationDelaySeconds >= 0 && data.separationDelaySeconds <= 600 &&
        isValidLatLon(data.centerLatitude, data.centerLongitude) &&
        data.leaderUid is string && data.leaderUid.size() >= 1 && data.leaderUid.size() <= 128 &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128;
    }

    function isValidMissionMember(data, orgId, missionId, memberUid) {
      return data.userId == memberUid &&
        data.orgId == orgId &&
        data.missionId == missionId &&
        data.teamId is string && data.teamId.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 32 &&
        data.photoUrl is string && data.photoUrl.size() <= 512 &&
        data.role in ['ORGANIZATION_ADMIN', 'TEAM_ADMIN', 'TEAM_MEMBER', 'SENSOR_OPERATOR'] &&
        data.status in ['ACTIVE', 'LEFT', 'REVOKED'] &&
        data.sharingEnabled is bool;
    }

    function isValidMemberLocation(data, orgId, missionId, memberUid) {
      return data.userId == memberUid &&
        data.orgId == orgId &&
        data.missionId == missionId &&
        data.teamId is string && data.teamId.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 32 &&
        data.role is string && data.role.size() <= 32 &&
        data.sharingEnabled is bool &&
        data.hasValidLocation is bool &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 50000 &&
        data.headingDegrees is number && data.headingDegrees >= 0 && data.headingDegrees <= 360 &&
        data.headingReliable is bool &&
        data.batteryPercent is int && data.batteryPercent >= 0 && data.batteryPercent <= 100 &&
        data.connectionStatus in ['online', 'offline', 'stale', 'gps_disabled', 'permission_denied', 'paused'] &&
        data.locationTimestampMillis is int && data.locationTimestampMillis >= 0 &&
        (!data.hasValidLocation || (data.sharingEnabled && data.locationTimestampMillis > 0)) &&
        data.unavailableReason is string && data.unavailableReason.size() <= 120;
    }

    function isValidSensorDevice(data, orgId, missionId, sensorId) {
      return data.sensorId == sensorId &&
        data.orgId == orgId &&
        data.missionId == missionId &&
        data.sensorType in ['uwb_life_detection_radar', 'fmcw_radar', 'thermal_imaging', 'acoustic_vibration', 'registered_ble_tag', 'uwb_ranging_tag'] &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.manufacturerModel is string && data.manufacturerModel.size() <= 80 &&
        data.transportType in ['gateway_http_tls', 'gateway_ws_tls', 'gateway_mqtt_tls', 'manufacturer_sdk_pending', 'ble_registered_tag'] &&
        data.connectionStatus in ['awaiting_integration', 'connecting', 'connected', 'disconnected', 'error'] &&
        data.hasPosition is bool &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.orientationDegrees is number && data.orientationDegrees >= 0 && data.orientationDegrees <= 360 &&
        data.sectorWidthDegrees is number && data.sectorWidthDegrees >= 0 && data.sectorWidthDegrees <= 360 &&
        data.maxRangeMeters is number && data.maxRangeMeters > 0 && data.maxRangeMeters <= 5000 &&
        data.calibrationVersion is string && data.calibrationVersion.size() <= 40 &&
        data.lastCalibrationMillis is int && data.lastCalibrationMillis >= 0 &&
        data.operatorUid is string && data.operatorUid.size() >= 1 && data.operatorUid.size() <= 128;
    }

    function isValidSensorHealth(data, orgId, missionId, sensorId) {
      return data.sensorId == sensorId &&
        data.orgId == orgId &&
        data.missionId == missionId &&
        data.healthState in ['healthy', 'degraded', 'offline', 'error', 'awaiting_integration'] &&
        data.lastHeartbeatMillis is int && data.lastHeartbeatMillis >= 0 &&
        data.packetsReceived is int && data.packetsReceived >= 0 &&
        data.packetsRejected is int && data.packetsRejected >= 0 &&
        data.diagnosticNote is string && data.diagnosticNote.size() <= 240;
    }

    function isValidSensorEvent(data, orgId, missionId, eventId) {
      return data.eventId == eventId &&
        data.orgId == orgId &&
        data.missionId == missionId &&
        data.sensorId is string && data.sensorId.size() >= 1 && data.sensorId.size() <= 128 &&
        data.sensorType in ['uwb_life_detection_radar', 'fmcw_radar', 'thermal_imaging', 'acoustic_vibration', 'registered_ble_tag', 'uwb_ranging_tag'] &&
        data.timestampUtcMillis is int && data.timestampUtcMillis > 0 &&
        data.detectionType is string && data.detectionType.size() >= 1 && data.detectionType.size() <= 80 &&
        data.confidence is number && data.confidence >= 0.0 && data.confidence <= 1.0 &&
        data.signalQuality in ['good', 'fair', 'poor', 'unusable'] &&
        data.sourceDevice is string && data.sourceDevice.size() >= 1 && data.sourceDevice.size() <= 100 &&
        data.calibrationVersion is string && data.calibrationVersion.size() <= 40 &&
        data.rawDataReference is string && data.rawDataReference.size() <= 200 &&
        data.dataValidity in ['valid', 'low_confidence', 'stale', 'uncertain'] &&
        data.status in ['active', 'stale', 'reviewed', 'cleared'] &&
        data.operatorUid is string && data.operatorUid.size() >= 1 && data.operatorUid.size() <= 128 &&
        (!('estimatedRangeMeters' in data) || data.estimatedRangeMeters == null || (data.estimatedRangeMeters is number && data.estimatedRangeMeters >= 0 && data.estimatedRangeMeters <= 5000)) &&
        (!('estimatedAzimuthDegrees' in data) || data.estimatedAzimuthDegrees == null || (data.estimatedAzimuthDegrees is number && data.estimatedAzimuthDegrees >= 0 && data.estimatedAzimuthDegrees <= 360)) &&
        (!('estimatedLatitude' in data) || data.estimatedLatitude == null || !('estimatedLongitude' in data) || data.estimatedLongitude == null || isValidLatLon(data.estimatedLatitude, data.estimatedLongitude));
    }

    function isValidDetectionObservation(data, orgId, missionId, detectionId) {
      return data.detectionId == detectionId &&
        data.orgId == orgId &&
        data.missionId == missionId &&
        data.sensorEventId is string && data.sensorEventId.size() >= 1 && data.sensorEventId.size() <= 128 &&
        data.sensorId is string && data.sensorId.size() >= 1 && data.sensorId.size() <= 128 &&
        data.operatorUid is string && data.operatorUid.size() >= 1 && data.operatorUid.size() <= 128 &&
        data.classificationLabel == 'UNCLASSIFIED POSSIBLE HUMAN PRESENCE' &&
        data.notes is string && data.notes.size() >= 1 && data.notes.size() <= 400 &&
        data.outcome in ['unverified_observation', 'investigating', 'confirmed_clear', 'rescue_requested'];
    }

    function isLegalSosTransition(fromStatus, toStatus) {
      return (fromStatus == toStatus) ||
        (fromStatus == 'active' && toStatus in ['acknowledged', 'responding', 'resolved', 'cancelled']) ||
        (fromStatus == 'acknowledged' && toStatus in ['responding', 'resolved', 'cancelled']) ||
        (fromStatus == 'responding' && toStatus in ['resolved', 'cancelled']);
    }

    function isValidSosAlert(data, orgId, missionId, alertId) {
      return data.alertId == alertId &&
        data.orgId == orgId &&
        data.missionId == missionId &&
        data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        data.teamId is string && data.teamId.size() <= 128 &&
        data.alertType in ['sos', 'separation_alert'] &&
        data.priority in ['critical', 'urgent'] &&
        data.status in ['active', 'acknowledged', 'responding', 'resolved', 'cancelled'] &&
        data.hasLocation is bool &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 50000 &&
        data.locationTimestampMillis is int && data.locationTimestampMillis >= 0 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
        data.acknowledgedByUid is string && data.acknowledgedByUid.size() <= 128 &&
        data.acknowledgedAtMillis is int && data.acknowledgedAtMillis >= 0 &&
        data.cancelledByUid is string && data.cancelledByUid.size() <= 128 &&
        data.cancelReason is string && data.cancelReason.size() <= 300 &&
        data.notificationStatus is string && data.notificationStatus.size() <= 40 &&
        data.deliveryNote is string && data.deliveryNote.size() <= 240 &&
        data.pushAttemptedCount is int && data.pushAttemptedCount >= 0;
    }

    function isValidGatewayDevice(data, orgId, gatewayId) {
      return data.gatewayId == gatewayId &&
        data.orgId == orgId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.transportType in ['http_tls', 'websocket_tls', 'mqtt_tls'] &&
        data.endpointUri is string && data.endpointUri.size() >= 1 && data.endpointUri.size() <= 256 &&
        data.status in ['online', 'degraded', 'offline', 'unverified'] &&
        data.bufferedEventCount is int && data.bufferedEventCount >= 0 &&
        data.lastHeartbeatMillis is int && data.lastHeartbeatMillis >= 0 &&
        data.registeredByUid is string && data.registeredByUid.size() >= 1 && data.registeredByUid.size() <= 128;
    }

    function isValidAuditLog(data, orgId) {
      return data.orgId == orgId &&
        data.missionId is string && data.missionId.size() <= 128 &&
        data.teamId is string && data.teamId.size() <= 128 &&
        data.actorUid == request.auth.uid &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80 &&
        data.category in ['membership', 'removal', 'reinstatement', 'invite', 'role', 'mission', 'sos', 'sensor', 'gateway'] &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.targetUid is string && data.targetUid.size() <= 128 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300;
    }

    // Authenticated responder profile (owner isolated)
    match /users/{userId} {
      allow get, list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().keys().hasAll(['userId', 'displayName', 'email', 'photoUrl', 'phoneOptional', 'callsign', 'activeOrgId', 'activeTeamId', 'activeMissionId', 'locationSharingEnabled', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'phoneOptional', 'callsign', 'activeOrgId', 'activeTeamId', 'activeMissionId', 'locationSharingEnabled', 'createdAt', 'updatedAt']) &&
        isValidTimestamp(incoming().createdAt) &&
        isValidTimestamp(incoming().updatedAt) &&
        isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        isValidTimestamp(incoming().updatedAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'phoneOptional', 'callsign', 'activeOrgId', 'activeTeamId', 'activeMissionId', 'locationSharingEnabled', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /devices/{deviceId} {
        allow get, list: if isOwner(userId) && isValidId(deviceId);
        allow create, update: if isOwner(userId) && isValidId(deviceId) &&
          incoming().keys().hasAll(['userId', 'deviceId', 'fcmToken', 'orgId', 'notificationsEnabled', 'platform', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'deviceId', 'fcmToken', 'orgId', 'notificationsEnabled', 'platform', 'updatedAt']) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidUserDeviceToken(incoming(), userId, deviceId);
        allow delete: if isOwner(userId) && isValidId(deviceId);
      }
    }

    // Multi-organization RBAC workspace collections
    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && (
        (isSignedIn() && resource == null && !isBlockedEmail(orgId)) ||
        isActiveOrgMember(orgId) ||
        (isSignedIn() && !isBlockedUser(orgId, request.auth.uid) && resource.data.createdByUid == request.auth.uid)
      );
      allow list: if false;
      allow create: if isSignedIn() && isValidId(orgId) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().keys().hasAll(['orgCode', 'orgName', 'region', 'allowMemberInvites', 'createdByUid', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['orgCode', 'orgName', 'region', 'allowMemberInvites', 'createdByUid', 'createdAt', 'updatedAt']) &&
        isValidTimestamp(incoming().createdAt) &&
        isValidTimestamp(incoming().updatedAt) &&
        isValidOrganization(incoming());
      allow update: if isOrgAdmin(orgId) && isValidId(orgId) &&
        isValidOrganization(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        isValidTimestamp(incoming().updatedAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['orgCode', 'orgName', 'region', 'allowMemberInvites', 'updatedAt']);
      allow delete: if false;

      match /blockedMemberships/{targetUid} {
        allow get: if isValidId(targetUid) && (isTeamOrOrgAdmin(orgId) || isOwner(targetUid));
        allow list: if isTeamOrOrgAdmin(orgId);
        allow create, update: if isOrgAdmin(orgId) && isValidId(targetUid) &&
          targetUid != request.auth.uid &&
          incoming().blockedByUid == request.auth.uid &&
          isValidTimestamp(incoming().createdAt) &&
          isValidBlockedMembership(incoming(), orgId, targetUid);
        // Only authorized Organization Admin can reinstate (unblock) a removed member
        allow delete: if isOrgAdmin(orgId) && isValidId(targetUid);
      }

      match /blockedEmails/{emailKey} {
        allow get, list: if isOrgAdmin(orgId);
        allow create, update: if isOrgAdmin(orgId) && isValidId(emailKey) &&
          incoming().blockedByUid == request.auth.uid &&
          incoming().orgId == orgId &&
          isValidTimestamp(incoming().createdAt);
        allow delete: if isOrgAdmin(orgId) && isValidId(emailKey);
      }

      match /invitations/{invitationId} {
        allow get: if isSignedIn() && isValidId(invitationId) && !isBlockedUser(orgId, request.auth.uid);
        allow list: if isActiveOrgMember(orgId);
        allow create: if isActiveOrgMember(orgId) && isValidId(invitationId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().usedCount == 0 &&
          incoming().expiresAtMillis > request.time.toMillis() &&
          incoming().keys().hasAll(['orgId', 'inviteCode', 'assignedRole', 'targetTeamId', 'targetMissionId', 'targetEmail', 'status', 'active', 'expiresAtMillis', 'maxUses', 'usedCount', 'createdByUid', 'createdByRole', 'approvedByUid', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['orgId', 'inviteCode', 'assignedRole', 'targetTeamId', 'targetMissionId', 'targetEmail', 'status', 'active', 'expiresAtMillis', 'maxUses', 'usedCount', 'createdByUid', 'createdByRole', 'approvedByUid', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidInvitation(incoming(), orgId) && (
            // Admin-issued invitation is immediately approved
            (isTeamOrOrgAdmin(orgId) && incoming().status == 'approved' && incoming().active == true && incoming().approvedByUid == request.auth.uid) ||
            // Member-issued invitation allowed ONLY if org setting enables allowMemberInvites, and MUST start pending_approval
            (orgAllowMemberInvites(orgId) && incoming().status == 'pending_approval' && incoming().active == false && incoming().approvedByUid == '')
          );
        allow update: if isValidId(invitationId) && isValidInvitation(incoming(), orgId) &&
          incoming().createdAt == existing().createdAt &&
          incoming().createdByUid == existing().createdByUid &&
          isValidTimestamp(incoming().updatedAt) && (
            // Admin approving, rejecting, revoking, or updating limits
            (isTeamOrOrgAdmin(orgId) &&
              (incoming().status != 'approved' || incoming().approvedByUid == request.auth.uid) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'active', 'assignedRole', 'expiresAtMillis', 'maxUses', 'approvedByUid', 'updatedAt'])) ||
            // Atomic invite redemption during member join transaction (never for blocked users!)
            (isSignedIn() &&
              !isBlockedUser(orgId, request.auth.uid) &&
              existing().status == 'approved' &&
              existing().active == true &&
              existing().usedCount < existing().maxUses &&
              existing().expiresAtMillis > request.time.toMillis() &&
              (existing().targetEmail == '' || (hasVerifiedEmail() && request.auth.token.email.lower() == existing().targetEmail.lower())) &&
              incoming().usedCount == existing().usedCount + 1 &&
              incoming().diff(existing()).affectedKeys().hasOnly(['usedCount', 'updatedAt']) &&
              existsAfter(memberPath(orgId, request.auth.uid)))
          );
        allow delete: if isTeamOrOrgAdmin(orgId) && isValidId(invitationId);
      }

      match /members/{memberUid} {
        allow get: if isValidId(memberUid) && (
          isActiveOrgMember(orgId) ||
          (isOwner(memberUid) && !isBlockedUser(orgId, memberUid))
        );
        allow list: if isActiveOrgMember(orgId);
        allow create: if isSignedIn() && isValidId(memberUid) &&
          !isBlockedUser(orgId, memberUid) &&
          incoming().keys().hasAll(['userId', 'orgId', 'displayName', 'callsign', 'photoUrl', 'role', 'teamId', 'status', 'availability', 'inviteCode', 'revokedByUid', 'revokedAtMillis', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'orgId', 'displayName', 'callsign', 'photoUrl', 'role', 'teamId', 'status', 'availability', 'inviteCode', 'revokedByUid', 'revokedAtMillis', 'createdAt', 'updatedAt']) &&
          incoming().status == 'ACTIVE' &&
          incoming().revokedByUid == '' &&
          incoming().revokedAtMillis == 0 &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidOrgMember(incoming(), orgId, memberUid) && (
            // 1. Org creator bootstrapping their own ORGANIZATION_ADMIN membership
            (request.auth.uid == memberUid &&
              incoming().role == 'ORGANIZATION_ADMIN' &&
              get(/databases/$(database)/documents/organizations/$(orgId)).data.createdByUid == request.auth.uid) ||
            // 2. Self-joining via an approved, active, unexpired, unexhausted invitation
            (request.auth.uid == memberUid &&
              incoming().role in ['TEAM_MEMBER', 'SENSOR_OPERATOR'] &&
              incoming().inviteCode.size() >= 8 &&
              exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(incoming().inviteCode)) &&
              get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(incoming().inviteCode)).data.status == 'approved' &&
              get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(incoming().inviteCode)).data.active == true &&
              get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(incoming().inviteCode)).data.expiresAtMillis > request.time.toMillis() &&
              get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(incoming().inviteCode)).data.usedCount < get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(incoming().inviteCode)).data.maxUses &&
              incoming().role == get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(incoming().inviteCode)).data.assignedRole &&
              (get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(incoming().inviteCode)).data.targetEmail == '' ||
                (hasVerifiedEmail() && request.auth.token.email.lower() == get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(incoming().inviteCode)).data.targetEmail.lower()))) ||
            // 3. Existing Org Admin adding a member directly
            isOrgAdmin(orgId)
          );
        allow update: if isSignedIn() && isValidId(memberUid) &&
          isValidOrgMember(incoming(), orgId, memberUid) &&
          incoming().userId == existing().userId &&
          incoming().orgId == existing().orgId &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) && (
            // Org Admin managing roles, teams, removal (REVOKED) or reinstatement (ACTIVE after deleting block doc)
            (isOrgAdmin(orgId) &&
              (incoming().status != 'REVOKED' || (memberUid != request.auth.uid && incoming().revokedByUid == request.auth.uid && incoming().revokedAtMillis > 0)) &&
              (incoming().status != 'ACTIVE' || !existsAfter(/databases/$(database)/documents/organizations/$(orgId)/blockedMemberships/$(memberUid))) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['role', 'teamId', 'status', 'availability', 'displayName', 'callsign', 'photoUrl', 'revokedByUid', 'revokedAtMillis', 'updatedAt'])) ||
            // Non-admin ACTIVE unblocked member updating only own availability/displayName/callsign/photoUrl (NEVER status, role, or teamId!)
            (request.auth.uid == memberUid &&
              isActiveOrgMember(orgId) &&
              existing().status == 'ACTIVE' &&
              incoming().status == existing().status &&
              incoming().role == existing().role &&
              incoming().teamId == existing().teamId &&
              incoming().revokedByUid == existing().revokedByUid &&
              incoming().revokedAtMillis == existing().revokedAtMillis &&
              incoming().diff(existing()).affectedKeys().hasOnly(['availability', 'displayName', 'callsign', 'photoUrl', 'updatedAt']))
          );
        allow delete: if false; // Preserve membership & revocation audit state; use REVOKED + blockedMemberships
      }

      match /teams/{teamId} {
        allow get, list: if isActiveOrgMember(orgId) && !isTeamBlocked(orgId, teamId, request.auth.uid);
        allow create: if isTeamOrOrgAdmin(orgId) && isValidId(teamId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().keys().hasAll(['orgId', 'teamCode', 'teamName', 'teamAdminUid', 'allowMemberInvites', 'memberCount', 'status', 'createdByUid', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['orgId', 'teamCode', 'teamName', 'teamAdminUid', 'allowMemberInvites', 'memberCount', 'status', 'createdByUid', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidRescueTeam(incoming(), orgId);
        allow update: if isTeamOrOrgAdmin(orgId) && isValidId(teamId) &&
          isValidRescueTeam(incoming(), orgId) &&
          incoming().orgId == existing().orgId &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['teamCode', 'teamName', 'teamAdminUid', 'allowMemberInvites', 'memberCount', 'status', 'updatedAt']);
        allow delete: if isOrgAdmin(orgId) && isValidId(teamId);

        match /teamMembers/{memberUid} {
          allow get, list: if isActiveOrgMember(orgId) && !isTeamBlocked(orgId, teamId, request.auth.uid);
          allow create: if isActiveOrgMember(orgId) && isValidId(memberUid) &&
            !isTeamBlocked(orgId, teamId, memberUid) &&
            incoming().status == 'ACTIVE' &&
            incoming().revokedByUid == '' &&
            isValidTimestamp(incoming().createdAt) &&
            isValidTimestamp(incoming().updatedAt) &&
            isValidTeamMember(incoming(), orgId, teamId, memberUid) &&
            (isTeamOrOrgAdmin(orgId) || (request.auth.uid == memberUid && incoming().role == memberRole(orgId)));
          allow update: if isTeamOrOrgAdmin(orgId) && isValidId(memberUid) &&
            isValidTeamMember(incoming(), orgId, teamId, memberUid) &&
            incoming().createdAt == existing().createdAt &&
            isValidTimestamp(incoming().updatedAt);
          allow delete: if isTeamOrOrgAdmin(orgId) && isValidId(memberUid);
        }

        match /blockedMemberships/{targetUid} {
          allow get: if isValidId(targetUid) && (isTeamOrOrgAdmin(orgId) || isOwner(targetUid));
          allow list: if isTeamOrOrgAdmin(orgId);
          allow create, update, delete: if isTeamOrOrgAdmin(orgId) && isValidId(targetUid);
        }
      }

      match /missions/{missionId} {
        allow get, list: if isActiveOrgMember(orgId) && !isMissionBlocked(orgId, missionId, request.auth.uid);
        allow create: if isTeamOrOrgAdmin(orgId) && isValidId(missionId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().keys().hasAll(['missionId', 'orgId', 'teamId', 'teamCode', 'title', 'description', 'environmentMode', 'status', 'separationAlertEnabled', 'separationThresholdMeters', 'separationDelaySeconds', 'centerLatitude', 'centerLongitude', 'leaderUid', 'createdByUid', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['missionId', 'orgId', 'teamId', 'teamCode', 'title', 'description', 'environmentMode', 'status', 'separationAlertEnabled', 'separationThresholdMeters', 'separationDelaySeconds', 'centerLatitude', 'centerLongitude', 'leaderUid', 'createdByUid', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidMission(incoming(), orgId, missionId);
        allow update: if isActiveOrgMember(orgId) && !isMissionBlocked(orgId, missionId, request.auth.uid) && isValidId(missionId) &&
          isValidMission(incoming(), orgId, missionId) &&
          incoming().orgId == existing().orgId &&
          incoming().missionId == existing().missionId &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) && (
            isTeamOrOrgAdmin(orgId) ||
            (isMissionParticipant(orgId, missionId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['environmentMode', 'status', 'updatedAt']))
          );
        allow delete: if isOrgAdmin(orgId) && isValidId(missionId);

        match /blockedMemberships/{targetUid} {
          allow get: if isValidId(targetUid) && (isTeamOrOrgAdmin(orgId) || isOwner(targetUid));
          allow list: if isTeamOrOrgAdmin(orgId);
          allow create, update, delete: if isTeamOrOrgAdmin(orgId) && isValidId(targetUid);
        }

        match /missionMembers/{memberUid} {
          allow get, list: if isActiveOrgMember(orgId) && !isMissionBlocked(orgId, missionId, request.auth.uid);
          allow create: if isActiveOrgMember(orgId) && isValidId(memberUid) &&
            !isMissionBlocked(orgId, missionId, memberUid) &&
            incoming().status == 'ACTIVE' &&
            isValidTimestamp(incoming().createdAt) &&
            isValidTimestamp(incoming().updatedAt) &&
            isValidMissionMember(incoming(), orgId, missionId, memberUid) && (
              isTeamOrOrgAdmin(orgId) ||
              (request.auth.uid == memberUid && incoming().role == memberRole(orgId))
            );
          allow update: if isActiveOrgMember(orgId) && isValidId(memberUid) &&
            isValidMissionMember(incoming(), orgId, missionId, memberUid) &&
            incoming().createdAt == existing().createdAt &&
            isValidTimestamp(incoming().updatedAt) && (
              (isTeamOrOrgAdmin(orgId) &&
                (incoming().status != 'ACTIVE' || !isMissionBlocked(orgId, missionId, memberUid))) ||
              (request.auth.uid == memberUid &&
                !isMissionBlocked(orgId, missionId, memberUid) &&
                existing().status != 'REVOKED' &&
                incoming().role == existing().role &&
                incoming().status in ['ACTIVE', 'LEFT'] &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sharingEnabled', 'updatedAt']))
            );
          allow delete: if isTeamOrOrgAdmin(orgId) && isValidId(memberUid);
        }

        match /locations/{memberUid} {
          allow get, list: if isMissionParticipant(orgId, missionId);
          allow create, update: if isMissionParticipant(orgId, missionId) &&
            request.auth.uid == memberUid &&
            isValidId(memberUid) &&
            isValidTimestamp(incoming().updatedAt) &&
            isValidMemberLocation(incoming(), orgId, missionId, memberUid);
          allow delete: if isTeamOrOrgAdmin(orgId) && isValidId(memberUid);
        }

        match /sensorDevices/{sensorId} {
          allow get, list: if isMissionParticipant(orgId, missionId);
          allow create, update: if isValidId(sensorId) &&
            isValidTimestamp(incoming().updatedAt) &&
            isValidSensorDevice(incoming(), orgId, missionId, sensorId) &&
            isMissionParticipant(orgId, missionId) &&
            hasSensorRole(orgId);
          allow delete: if isTeamOrOrgAdmin(orgId) && isValidId(sensorId);
        }

        match /sensorHealth/{sensorId} {
          allow get, list: if isMissionParticipant(orgId, missionId);
          allow create, update: if isValidId(sensorId) &&
            isValidTimestamp(incoming().updatedAt) &&
            isValidSensorHealth(incoming(), orgId, missionId, sensorId) &&
            isMissionParticipant(orgId, missionId) &&
            hasSensorRole(orgId);
          allow delete: if isTeamOrOrgAdmin(orgId) && isValidId(sensorId);
        }

        match /sensorEvents/{eventId} {
          allow get, list: if isMissionParticipant(orgId, missionId);
          allow create: if isValidId(eventId) &&
            isValidTimestamp(incoming().createdAt) &&
            isValidSensorEvent(incoming(), orgId, missionId, eventId) &&
            isMissionParticipant(orgId, missionId) &&
            hasSensorRole(orgId);
          allow update: if isValidId(eventId) &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'dataValidity']) &&
            isMissionParticipant(orgId, missionId) &&
            hasSensorRole(orgId);
          allow delete: if isTeamOrOrgAdmin(orgId) && isValidId(eventId);
        }

        match /detections/{detectionId} {
          allow get, list: if isMissionParticipant(orgId, missionId);
          allow create: if isValidId(detectionId) &&
            incoming().operatorUid == request.auth.uid &&
            isValidTimestamp(incoming().createdAt) &&
            isValidTimestamp(incoming().updatedAt) &&
            isValidDetectionObservation(incoming(), orgId, missionId, detectionId) &&
            isMissionParticipant(orgId, missionId);
          allow update: if isValidId(detectionId) &&
            incoming().createdAt == existing().createdAt &&
            isValidTimestamp(incoming().updatedAt) &&
            isValidDetectionObservation(incoming(), orgId, missionId, detectionId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'outcome', 'updatedAt']) &&
            isMissionParticipant(orgId, missionId);
          allow delete: if isTeamOrOrgAdmin(orgId) && isValidId(detectionId);
        }

        match /sosAlerts/{alertId} {
          allow get, list: if isMissionParticipant(orgId, missionId);
          allow create: if isValidId(alertId) &&
            incoming().senderUid == request.auth.uid &&
            incoming().status == 'active' &&
            incoming().acknowledgedByUid == '' &&
            incoming().acknowledgedAtMillis == 0 &&
            incoming().cancelledByUid == '' &&
            incoming().cancelReason == '' &&
            isValidTimestamp(incoming().createdAt) &&
            isValidTimestamp(incoming().updatedAt) &&
            isValidSosAlert(incoming(), orgId, missionId, alertId) &&
            isMissionParticipant(orgId, missionId);
          allow update: if isValidId(alertId) &&
            !(existing().status in ['resolved', 'cancelled']) &&
            isLegalSosTransition(existing().status, incoming().status) &&
            incoming().orgId == existing().orgId &&
            incoming().missionId == existing().missionId &&
            incoming().alertId == existing().alertId &&
            incoming().senderUid == existing().senderUid &&
            incoming().senderName == existing().senderName &&
            incoming().teamId == existing().teamId &&
            incoming().alertType == existing().alertType &&
            incoming().createdAt == existing().createdAt &&
            isValidTimestamp(incoming().updatedAt) &&
            isValidSosAlert(incoming(), orgId, missionId, alertId) &&
            isMissionParticipant(orgId, missionId) && (
              // Cancellation by sender or Team/Org Admin requires audit reason
              (incoming().status == 'cancelled' &&
                incoming().cancelledByUid == request.auth.uid &&
                incoming().cancelReason.size() >= 3 &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledByUid', 'cancelReason', 'updatedAt']) &&
                (request.auth.uid == existing().senderUid || hasAdminRole(orgId))) ||
              // Resolution by Team/Org Admin
              (incoming().status == 'resolved' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                hasAdminRole(orgId)) ||
              // Acknowledge / Responding by any active mission participant
              (incoming().status in ['acknowledged', 'responding'] &&
                (incoming().status != 'acknowledged' || (incoming().acknowledgedByUid == request.auth.uid && incoming().acknowledgedAtMillis > 0)) &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acknowledgedByUid', 'acknowledgedAtMillis', 'updatedAt']))
            );
          allow delete: if false;
        }

        // Server-side push dispatch logs (Cloud Functions Admin SDK only)
        match /notificationDispatches/{dispatchId} {
          allow get, list: if isMissionParticipant(orgId, missionId);
          allow create, update, delete: if false;
        }
      }

      match /gatewayDevices/{gatewayId} {
        allow get, list: if isActiveOrgMember(orgId);
        allow create, update: if isSensorAuthorized(orgId) &&
          isValidId(gatewayId) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidGatewayDevice(incoming(), orgId, gatewayId);
        allow delete: if isTeamOrOrgAdmin(orgId) && isValidId(gatewayId);
      }

      match /auditLogs/{logId} {
        allow get, list: if isActiveOrgMember(orgId);
        allow create: if isActiveOrgMember(orgId) &&
          isValidId(logId) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidAuditLog(incoming(), orgId);
        allow update, delete: if false;
      }
    }
  }
}
