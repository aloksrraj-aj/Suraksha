rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidLatLon(lat, lon) {
      return lat is number && lat >= -90 && lat <= 90 &&
             lon is number && lon >= -180 && lon <= 180;
    }

    // Organization RBAC helpers (never trust client-supplied roles)
    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function memberData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
    }

    function memberRole(orgId) {
      return memberData(orgId).role;
    }

    function memberTeamId(orgId) {
      return memberData(orgId).teamId;
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && memberRole(orgId) == 'org_admin';
    }

    function isTeamLeaderOrAdmin(orgId) {
      return isOrgMember(orgId) && memberRole(orgId) in ['org_admin', 'team_leader'];
    }

    function isActiveResponder(orgId) {
      return isOrgMember(orgId) && memberRole(orgId) in ['org_admin', 'team_leader', 'operator', 'medic'];
    }

    function canUpdateTeamLocation(orgId, teamId) {
      return isActiveResponder(orgId) && (
        isTeamLeaderOrAdmin(orgId) ||
        existing().leaderUid == request.auth.uid ||
        existing().userId == request.auth.uid ||
        memberTeamId(orgId) == teamId
      );
    }

    function isLegalSosTransition(fromStatus, toStatus) {
      return (fromStatus == toStatus) ||
        (fromStatus == 'created' && toStatus in ['pending_delivery', 'delivered', 'failed']) ||
        (fromStatus == 'pending_delivery' && toStatus in ['delivered', 'acknowledged', 'failed']) ||
        (fromStatus == 'failed' && toStatus in ['pending_delivery', 'delivered']) ||
        (fromStatus == 'delivered' && toStatus in ['acknowledged', 'team_assigned', 'responding', 'resolved', 'closed']) ||
        (fromStatus == 'acknowledged' && toStatus in ['team_assigned', 'responding', 'resolved', 'closed']) ||
        (fromStatus == 'team_assigned' && toStatus in ['responding', 'resolved', 'closed']) ||
        (fromStatus == 'responding' && toStatus in ['resolved', 'closed']) ||
        (fromStatus == 'resolved' && toStatus == 'closed');
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 30 &&
        data.activeOrgId is string && data.activeOrgId.size() <= 128 &&
        data.teamId is string && data.teamId.size() >= 1 && data.teamId.size() <= 64 &&
        data.teamName is string && data.teamName.size() >= 1 && data.teamName.size() <= 80 &&
        data.role in ['org_admin', 'team_leader', 'operator', 'medic', 'observer', 'coordinator'] &&
        data.locationSharingEnabled is bool &&
        data.backgroundTrackingEnabled is bool;
    }

    function isValidUserDeviceToken(data, userId, deviceId) {
      return data.userId == userId &&
        data.deviceId == deviceId &&
        data.fcmToken is string && data.fcmToken.size() >= 10 && data.fcmToken.size() <= 512 &&
        data.orgId is string && data.orgId.size() <= 128 &&
        data.notificationsEnabled is bool &&
        data.platform == 'android';
    }

    function isValidOrganization(data) {
      return data.orgCode is string && data.orgCode.size() >= 2 && data.orgCode.size() <= 32 &&
        data.orgName is string && data.orgName.size() >= 2 && data.orgName.size() <= 100 &&
        data.region is string && data.region.size() >= 1 && data.region.size() <= 80 &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128;
    }

    function isValidOrgInvite(data, orgId, inviteCode) {
      return data.orgId == orgId &&
        data.inviteCode == inviteCode &&
        data.inviteCode is string && data.inviteCode.size() >= 8 && data.inviteCode.size() <= 32 &&
        data.defaultRole in ['operator', 'observer'] &&
        data.active is bool &&
        data.expiresAtMillis is int && data.expiresAtMillis > 0 &&
        data.maxUses is int && data.maxUses >= 1 && data.maxUses <= 500 &&
        data.usedCount is int && data.usedCount >= 0 && data.usedCount <= data.maxUses &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128;
    }

    function isValidOrgMember(data, orgId, memberUid) {
      return data.userId == memberUid &&
        data.orgId == orgId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 30 &&
        data.role in ['org_admin', 'team_leader', 'operator', 'medic', 'observer'] &&
        data.teamId is string && data.teamId.size() <= 64 &&
        data.availability in ['available', 'deployed', 'standby', 'offline'] &&
        data.inviteCode is string && data.inviteCode.size() <= 32;
    }

    function isValidRescueTeam(data, orgId) {
      return data.orgId == orgId &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.leaderUid is string && data.leaderUid.size() >= 1 && data.leaderUid.size() <= 128 &&
        data.teamCode is string && data.teamCode.size() >= 1 && data.teamCode.size() <= 32 &&
        data.teamName is string && data.teamName.size() >= 1 && data.teamName.size() <= 80 &&
        data.memberCount is int && data.memberCount >= 1 && data.memberCount <= 200 &&
        data.activeCount is int && data.activeCount >= 0 && data.activeCount <= data.memberCount &&
        data.status in ['active', 'deployed', 'standby', 'offline'] &&
        data.locationSharingOptIn is bool &&
        data.hasValidLocation is bool &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 50000 &&
        data.locationTimestampMillis is int && data.locationTimestampMillis >= 0 &&
        data.locationUnavailableReason is string && data.locationUnavailableReason.size() <= 120 &&
        (!data.hasValidLocation || (data.locationSharingOptIn && data.locationTimestampMillis > 0 && data.locationTimestampMillis <= request.time.toMillis() + 60000)) &&
        data.batteryPercent is int && data.batteryPercent >= 0 && data.batteryPercent <= 100 &&
        data.connectionStatus in ['online', 'offline', 'stale', 'low_bandwidth'] &&
        data.isSynthetic is bool;
    }

    function isValidRescueLocation(data, orgId) {
      return data.orgId == orgId &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.region is string && data.region.size() >= 1 && data.region.size() <= 80 &&
        data.hazardType in ['earthquake', 'flood', 'landslide', 'structural_collapse', 'other'] &&
        data.severity in ['critical', 'high', 'moderate', 'low'] &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.radiusMeters is number && data.radiusMeters >= 10 && data.radiusMeters <= 100000 &&
        data.verificationStatus in ['verified', 'estimated', 'unverified', 'outdated'] &&
        data.dataSource is string && data.dataSource.size() >= 1 && data.dataSource.size() <= 100 &&
        data.isSynthetic is bool;
    }

    function isValidPresenceSignal(data, orgId) {
      return data.orgId == orgId &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.locationId is string && data.locationId.size() >= 1 && data.locationId.size() <= 128 &&
        data.sectorLabel is string && data.sectorLabel.size() >= 1 && data.sectorLabel.size() <= 80 &&
        data.signalType in ['thermal_ir', 'radar_respiration', 'acoustic_vibration', 'co2_plume', 'lidar_void'] &&
        data.sourceKind in ['simulated', 'hardware'] &&
        data.deviceId is string && data.deviceId.size() <= 80 &&
        data.calibrationStatus in ['calibrated', 'needs_calibration', 'nominal', 'unknown'] &&
        data.sensorHealth in ['healthy', 'degraded', 'error', 'offline'] &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.hasCoordinates is bool &&
        data.estimatedMinCount is int && data.estimatedMinCount >= 0 && data.estimatedMinCount <= 500 &&
        data.estimatedMaxCount is int && data.estimatedMaxCount >= data.estimatedMinCount && data.estimatedMaxCount <= 500 &&
        data.confidencePercent is int && data.confidencePercent >= 0 && data.confidencePercent <= 100 &&
        data.verificationStatus in ['estimated', 'unverified', 'field_verified', 'outdated'] &&
        data.dataSource is string && data.dataSource.size() >= 1 && data.dataSource.size() <= 100 &&
        data.verifiedByUid is string && data.verifiedByUid.size() <= 128 &&
        data.verificationNotes is string && data.verificationNotes.size() <= 300 &&
        data.observationTimestampMillis is int && data.observationTimestampMillis >= 0 &&
        data.isSynthetic is bool;
    }

    function isValidRegistryEntry(data, orgId) {
      return data.orgId == orgId &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.category in ['missing_person', 'verified_survivor', 'medical_request', 'disaster_site'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.locationName is string && data.locationName.size() >= 1 && data.locationName.size() <= 100 &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.hasCoordinates is bool &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 600 &&
        data.sensitiveContactMasked is string && data.sensitiveContactMasked.size() <= 120 &&
        data.photoUriLocal is string && data.photoUriLocal.size() <= 240 &&
        data.photoConsentGranted is bool &&
        data.rescueStatus in ['open', 'dispatched', 'in_progress', 'resolved'] &&
        data.verificationStatus in ['reported', 'under_verification', 'verified', 'unverified', 'duplicate', 'resolved'] &&
        data.informationSource is string && data.informationSource.size() >= 1 && data.informationSource.size() <= 100 &&
        data.verifierUid is string && data.verifierUid.size() <= 128 &&
        data.verificationNotes is string && data.verificationNotes.size() <= 300 &&
        data.duplicateOfId is string && data.duplicateOfId.size() <= 128 &&
        data.isSynthetic is bool;
    }

    function isValidSosIncident(data, orgId, incidentId) {
      return data.orgId == orgId &&
        data.incidentId == incidentId &&
        data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        data.teamCode is string && data.teamCode.size() >= 1 && data.teamCode.size() <= 32 &&
        data.priority in ['sos', 'urgent', 'routine'] &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
        data.status in ['created', 'pending_delivery', 'delivered', 'acknowledged', 'team_assigned', 'responding', 'resolved', 'closed', 'failed'] &&
        data.hasLocation is bool &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 50000 &&
        data.assignedTeamId is string && data.assignedTeamId.size() <= 128 &&
        data.assignedTeamCode is string && data.assignedTeamCode.size() <= 32 &&
        data.acknowledgedByUid is string && data.acknowledgedByUid.size() <= 128 &&
        data.acknowledgedAtMillis is int && data.acknowledgedAtMillis >= 0 &&
        data.deliveryNote is string && data.deliveryNote.size() <= 200 &&
        data.isSynthetic is bool;
    }

    function isValidSosAuditLog(data, orgId, incidentId) {
      return data.orgId == orgId &&
        data.incidentId == incidentId &&
        data.actorUid == request.auth.uid &&
        data.fromStatus is string && data.fromStatus.size() <= 32 &&
        data.toStatus in ['created', 'pending_delivery', 'delivered', 'acknowledged', 'team_assigned', 'responding', 'resolved', 'closed', 'failed'] &&
        data.note is string && data.note.size() >= 1 && data.note.size() <= 300;
    }

    function isValidActivityLog(data, orgId) {
      return data.orgId == orgId &&
        data.actorUid == request.auth.uid &&
        data.category in ['sos', 'team', 'location', 'presence', 'registry', 'mission', 'invite', 'ai'] &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 240;
    }

    function isValidMission(data, orgId, missionId) {
      return data.orgId == orgId &&
        data.missionId == missionId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.assignedTeamId is string && data.assignedTeamId.size() <= 128 &&
        data.assignedTeamCode is string && data.assignedTeamCode.size() <= 32 &&
        data.priority in ['critical', 'high', 'moderate', 'routine'] &&
        data.status in ['planned', 'dispatched', 'in_progress', 'completed', 'aborted'] &&
        isValidLatLon(data.targetLatitude, data.targetLongitude) &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128;
    }

    function isValidBlockedRoad(data, orgId) {
      return data.orgId == orgId &&
        data.reportedByUid is string && data.reportedByUid.size() >= 1 && data.reportedByUid.size() <= 128 &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.severity in ['blocked', 'restricted', 'hazard_caution'] &&
        data.active is bool;
    }

    function isValidDroneTelemetry(data, orgId, droneId) {
      return data.orgId == orgId &&
        data.droneId == droneId &&
        data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 32 &&
        data.sourceKind in ['simulated', 'hardware'] &&
        data.status in ['idle', 'airborne', 'returning', 'offline'] &&
        isValidLatLon(data.latitude, data.longitude) &&
        data.altitudeMeters is number && data.altitudeMeters >= 0 && data.altitudeMeters <= 10000 &&
        data.batteryPercent is int && data.batteryPercent >= 0 && data.batteryPercent <= 100;
    }

    // Legacy user-scoped profile & personal backward-compatibility collections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().keys().hasAll(['userId', 'displayName', 'callsign', 'activeOrgId', 'teamId', 'teamName', 'role', 'locationSharingEnabled', 'backgroundTrackingEnabled', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'displayName', 'callsign', 'activeOrgId', 'teamId', 'teamName', 'role', 'locationSharingEnabled', 'backgroundTrackingEnabled', 'createdAt', 'updatedAt']) &&
        isValidTimestamp(incoming().createdAt) &&
        isValidTimestamp(incoming().updatedAt) &&
        isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        isValidTimestamp(incoming().updatedAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'callsign', 'activeOrgId', 'teamId', 'teamName', 'role', 'locationSharingEnabled', 'backgroundTrackingEnabled', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Device FCM token registration (owner-scoped only)
      match /devices/{deviceId} {
        allow get, list: if isOwner(userId) && isValidId(deviceId);
        allow create, update: if isOwner(userId) && isValidId(deviceId) &&
          incoming().keys().hasAll(['userId', 'deviceId', 'fcmToken', 'orgId', 'notificationsEnabled', 'platform', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'deviceId', 'fcmToken', 'orgId', 'notificationsEnabled', 'platform', 'updatedAt']) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidUserDeviceToken(incoming(), userId, deviceId);
        allow delete: if isOwner(userId) && isValidId(deviceId);
      }

      // Preserve read access for legacy personal subcollections during migration
      match /rescue_teams/{docId} { allow read: if isOwner(userId); }
      match /rescue_locations/{docId} { allow read: if isOwner(userId); }
      match /presence_signals/{docId} { allow read: if isOwner(userId); }
      match /rescue_registry/{docId} { allow read: if isOwner(userId); }
      match /team_alerts/{docId} { allow read: if isOwner(userId); }
    }

    // Multi-Organization RBAC Workspace Collections
    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && (
        (isSignedIn() && resource == null) ||
        isOrgMember(orgId) ||
        (isSignedIn() && resource.data.createdByUid == request.auth.uid)
      );
      allow list: if false;
      allow create: if isSignedIn() && isValidId(orgId) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().keys().hasAll(['orgCode', 'orgName', 'region', 'createdByUid', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['orgCode', 'orgName', 'region', 'createdByUid', 'createdAt', 'updatedAt']) &&
        isValidTimestamp(incoming().createdAt) &&
        isValidTimestamp(incoming().updatedAt) &&
        isValidOrganization(incoming());
      allow update: if isOrgAdmin(orgId) && isValidId(orgId) &&
        isValidOrganization(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        isValidTimestamp(incoming().updatedAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['orgCode', 'orgName', 'region', 'updatedAt']);
      allow delete: if false;

      match /invites/{inviteCode} {
        allow get: if isSignedIn() && isValidId(inviteCode);
        allow list: if isOrgAdmin(orgId);
        allow create: if isOrgAdmin(orgId) && isValidId(inviteCode) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().usedCount == 0 &&
          incoming().expiresAtMillis > request.time.toMillis() &&
          incoming().keys().hasAll(['orgId', 'inviteCode', 'defaultRole', 'active', 'expiresAtMillis', 'maxUses', 'usedCount', 'createdByUid', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['orgId', 'inviteCode', 'defaultRole', 'active', 'expiresAtMillis', 'maxUses', 'usedCount', 'createdByUid', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidOrgInvite(incoming(), orgId, inviteCode);
        allow update: if isValidId(inviteCode) && isValidOrgInvite(incoming(), orgId, inviteCode) &&
          incoming().createdAt == existing().createdAt &&
          incoming().createdByUid == existing().createdByUid &&
          isValidTimestamp(incoming().updatedAt) && (
            (isOrgAdmin(orgId) && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'defaultRole', 'expiresAtMillis', 'maxUses', 'updatedAt'])) ||
            // Atomic invite redemption during member creation transaction
            (isSignedIn() &&
              existing().active == true &&
              existing().usedCount < existing().maxUses &&
              existing().expiresAtMillis > request.time.toMillis() &&
              incoming().usedCount == existing().usedCount + 1 &&
              incoming().diff(existing()).affectedKeys().hasOnly(['usedCount', 'updatedAt']) &&
              !exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
              existsAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)))
          );
        allow delete: if isOrgAdmin(orgId) && isValidId(inviteCode);
      }

      match /members/{memberUid} {
        allow get: if isValidId(memberUid) && (isOrgMember(orgId) || isOwner(memberUid));
        allow list: if isOrgMember(orgId);
        allow create: if isSignedIn() && isValidId(memberUid) &&
          incoming().keys().hasAll(['userId', 'orgId', 'displayName', 'callsign', 'role', 'teamId', 'availability', 'inviteCode', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'orgId', 'displayName', 'callsign', 'role', 'teamId', 'availability', 'inviteCode', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidOrgMember(incoming(), orgId, memberUid) && (
            // 1. Org creator bootstrapping their own org_admin membership
            (request.auth.uid == memberUid &&
              incoming().role == 'org_admin' &&
              get(/databases/$(database)/documents/organizations/$(orgId)).data.createdByUid == request.auth.uid) ||
            // 2. Self-joining via an active, unexpired, unexhausted high-entropy invite code
            (request.auth.uid == memberUid &&
              incoming().role in ['operator', 'observer'] &&
              incoming().inviteCode.size() >= 8 &&
              exists(/databases/$(database)/documents/organizations/$(orgId)/invites/$(incoming().inviteCode)) &&
              get(/databases/$(database)/documents/organizations/$(orgId)/invites/$(incoming().inviteCode)).data.active == true &&
              get(/databases/$(database)/documents/organizations/$(orgId)/invites/$(incoming().inviteCode)).data.expiresAtMillis > request.time.toMillis() &&
              get(/databases/$(database)/documents/organizations/$(orgId)/invites/$(incoming().inviteCode)).data.usedCount < get(/databases/$(database)/documents/organizations/$(orgId)/invites/$(incoming().inviteCode)).data.maxUses &&
              incoming().role == get(/databases/$(database)/documents/organizations/$(orgId)/invites/$(incoming().inviteCode)).data.defaultRole) ||
            // 3. Existing org admin adding a member
            isOrgAdmin(orgId)
          );
        allow update: if isSignedIn() && isValidId(memberUid) &&
          isValidOrgMember(incoming(), orgId, memberUid) &&
          incoming().userId == existing().userId &&
          incoming().orgId == existing().orgId &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) && (
            // Only org_admin can change roles or team assignments
            (isOrgAdmin(orgId) && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'teamId', 'availability', 'displayName', 'callsign', 'updatedAt'])) ||
            // Non-admin member can only update own availability/callsign/displayName (never role or teamId!)
            (request.auth.uid == memberUid &&
              incoming().role == existing().role &&
              incoming().teamId == existing().teamId &&
              incoming().diff(existing()).affectedKeys().hasOnly(['availability', 'callsign', 'displayName', 'updatedAt']))
          );
        allow delete: if isOrgAdmin(orgId) && isValidId(memberUid) && memberUid != request.auth.uid;
      }

      match /teams/{teamId} {
        allow get: if isOrgMember(orgId) && isValidId(teamId);
        allow list: if isOrgMember(orgId);
        allow create: if isTeamLeaderOrAdmin(orgId) && isValidId(teamId) &&
          incoming().userId == request.auth.uid &&
          incoming().keys().hasAll(['orgId', 'userId', 'leaderUid', 'teamCode', 'teamName', 'memberCount', 'activeCount', 'status', 'locationSharingOptIn', 'hasValidLocation', 'latitude', 'longitude', 'accuracyMeters', 'locationTimestampMillis', 'locationUnavailableReason', 'batteryPercent', 'connectionStatus', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['orgId', 'userId', 'leaderUid', 'teamCode', 'teamName', 'memberCount', 'activeCount', 'status', 'locationSharingOptIn', 'hasValidLocation', 'latitude', 'longitude', 'accuracyMeters', 'locationTimestampMillis', 'locationUnavailableReason', 'batteryPercent', 'connectionStatus', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidRescueTeam(incoming(), orgId);
        allow update: if canUpdateTeamLocation(orgId, teamId) && isValidId(teamId) &&
          isValidRescueTeam(incoming(), orgId) &&
          incoming().orgId == existing().orgId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          // Monotonic timestamp check when updating valid location fixes
          (!incoming().hasValidLocation || !existing().hasValidLocation || incoming().locationTimestampMillis >= existing().locationTimestampMillis) && (
            isTeamLeaderOrAdmin(orgId) ||
            (incoming().leaderUid == existing().leaderUid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['locationSharingOptIn', 'hasValidLocation', 'latitude', 'longitude', 'accuracyMeters', 'locationTimestampMillis', 'locationUnavailableReason', 'batteryPercent', 'connectionStatus', 'updatedAt']))
          );
        allow delete: if isOrgAdmin(orgId) && isValidId(teamId);
      }

      match /locations/{locationId} {
        allow get: if isOrgMember(orgId) && isValidId(locationId);
        allow list: if isOrgMember(orgId);
        allow create: if isActiveResponder(orgId) && isValidId(locationId) &&
          incoming().userId == request.auth.uid &&
          incoming().keys().hasAll(['orgId', 'userId', 'name', 'region', 'hazardType', 'severity', 'latitude', 'longitude', 'radiusMeters', 'verificationStatus', 'dataSource', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['orgId', 'userId', 'name', 'region', 'hazardType', 'severity', 'latitude', 'longitude', 'radiusMeters', 'verificationStatus', 'dataSource', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidRescueLocation(incoming(), orgId);
        allow update: if isActiveResponder(orgId) && isValidId(locationId) &&
          isValidRescueLocation(incoming(), orgId) &&
          incoming().orgId == existing().orgId &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'region', 'hazardType', 'severity', 'latitude', 'longitude', 'radiusMeters', 'verificationStatus', 'dataSource', 'updatedAt']);
        allow delete: if isTeamLeaderOrAdmin(orgId) && isValidId(locationId);
      }

      match /presence_signals/{signalId} {
        allow get: if isOrgMember(orgId) && isValidId(signalId);
        allow list: if isOrgMember(orgId);
        allow create: if isActiveResponder(orgId) && isValidId(signalId) &&
          incoming().userId == request.auth.uid &&
          incoming().verificationStatus in ['estimated', 'unverified'] &&
          incoming().keys().hasAll(['orgId', 'userId', 'locationId', 'sectorLabel', 'signalType', 'sourceKind', 'deviceId', 'calibrationStatus', 'sensorHealth', 'latitude', 'longitude', 'hasCoordinates', 'estimatedMinCount', 'estimatedMaxCount', 'confidencePercent', 'verificationStatus', 'dataSource', 'verifiedByUid', 'verificationNotes', 'observationTimestampMillis', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['orgId', 'userId', 'locationId', 'sectorLabel', 'signalType', 'sourceKind', 'deviceId', 'calibrationStatus', 'sensorHealth', 'latitude', 'longitude', 'hasCoordinates', 'estimatedMinCount', 'estimatedMaxCount', 'confidencePercent', 'verificationStatus', 'dataSource', 'verifiedByUid', 'verificationNotes', 'observationTimestampMillis', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidPresenceSignal(incoming(), orgId);
        allow update: if isActiveResponder(orgId) && isValidId(signalId) &&
          isValidPresenceSignal(incoming(), orgId) &&
          incoming().orgId == existing().orgId &&
          incoming().sourceKind == existing().sourceKind &&
          incoming().isSynthetic == existing().isSynthetic &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          (incoming().verificationStatus != 'field_verified' ||
            (existing().sourceKind == 'hardware' && !existing().isSynthetic &&
             incoming().verifiedByUid == request.auth.uid && incoming().verificationNotes.size() >= 3)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['verificationStatus', 'confidencePercent', 'verifiedByUid', 'verificationNotes', 'sensorHealth', 'updatedAt']);
        allow delete: if isTeamLeaderOrAdmin(orgId) && isValidId(signalId);
      }

      match /registry/{entryId} {
        allow get: if isOrgMember(orgId) && isValidId(entryId);
        allow list: if isOrgMember(orgId);
        allow create: if isActiveResponder(orgId) && isValidId(entryId) &&
          incoming().userId == request.auth.uid &&
          incoming().keys().hasAll(['orgId', 'userId', 'category', 'title', 'locationName', 'latitude', 'longitude', 'hasCoordinates', 'details', 'sensitiveContactMasked', 'photoUriLocal', 'photoConsentGranted', 'rescueStatus', 'verificationStatus', 'informationSource', 'verifierUid', 'verificationNotes', 'duplicateOfId', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['orgId', 'userId', 'category', 'title', 'locationName', 'latitude', 'longitude', 'hasCoordinates', 'details', 'sensitiveContactMasked', 'photoUriLocal', 'photoConsentGranted', 'rescueStatus', 'verificationStatus', 'informationSource', 'verifierUid', 'verificationNotes', 'duplicateOfId', 'medicalCategory', 'medicalUrgency', 'assignedMedicalTeam', 'linkedIncidentId', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidRegistryEntry(incoming(), orgId);
        allow update: if isActiveResponder(orgId) && isValidId(entryId) &&
          isValidRegistryEntry(incoming(), orgId) &&
          incoming().orgId == existing().orgId &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['category', 'title', 'locationName', 'latitude', 'longitude', 'hasCoordinates', 'details', 'sensitiveContactMasked', 'photoUriLocal', 'photoConsentGranted', 'rescueStatus', 'verificationStatus', 'informationSource', 'verifierUid', 'verificationNotes', 'duplicateOfId', 'medicalCategory', 'medicalUrgency', 'assignedMedicalTeam', 'linkedIncidentId', 'updatedAt']);
        allow delete: if isTeamLeaderOrAdmin(orgId) && isValidId(entryId);
      }

      match /sos_incidents/{incidentId} {
        allow get: if isOrgMember(orgId) && isValidId(incidentId);
        allow list: if isOrgMember(orgId);
        allow create: if isActiveResponder(orgId) && isValidId(incidentId) &&
          incoming().senderUid == request.auth.uid &&
          incoming().status in ['created', 'pending_delivery', 'delivered'] &&
          incoming().acknowledgedByUid == '' &&
          incoming().acknowledgedAtMillis == 0 &&
          incoming().keys().hasAll(['incidentId', 'orgId', 'senderUid', 'senderName', 'teamCode', 'priority', 'description', 'status', 'hasLocation', 'latitude', 'longitude', 'accuracyMeters', 'assignedTeamId', 'assignedTeamCode', 'acknowledgedByUid', 'acknowledgedAtMillis', 'deliveryNote', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['incidentId', 'orgId', 'senderUid', 'senderName', 'teamCode', 'priority', 'description', 'status', 'hasLocation', 'latitude', 'longitude', 'accuracyMeters', 'assignedTeamId', 'assignedTeamCode', 'acknowledgedByUid', 'acknowledgedAtMillis', 'deliveryNote', 'notificationStatus', 'pushAttemptedCount', 'isSynthetic', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidSosIncident(incoming(), orgId, incidentId);
        allow update: if isActiveResponder(orgId) && isValidId(incidentId) &&
          isValidSosIncident(incoming(), orgId, incidentId) &&
          incoming().orgId == existing().orgId &&
          incoming().incidentId == existing().incidentId &&
          incoming().senderUid == existing().senderUid &&
          incoming().senderName == existing().senderName &&
          incoming().teamCode == existing().teamCode &&
          incoming().priority == existing().priority &&
          incoming().description == existing().description &&
          incoming().hasLocation == existing().hasLocation &&
          incoming().latitude == existing().latitude &&
          incoming().longitude == existing().longitude &&
          incoming().accuracyMeters == existing().accuracyMeters &&
          incoming().isSynthetic == existing().isSynthetic &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          // Terminal state locking once closed & strict state machine validation
          existing().status != 'closed' &&
          isLegalSosTransition(existing().status, incoming().status) &&
          // Ack attribution lock: only authentic actor can set acknowledgedByUid, and once set it is immutable
          (existing().acknowledgedByUid == ''
            ? (incoming().status != 'acknowledged' || (incoming().acknowledgedByUid == request.auth.uid && incoming().acknowledgedAtMillis > 0))
            : incoming().acknowledgedByUid == existing().acknowledgedByUid) && (
            // Team leader / admin can assign, respond, resolve, or close
            (isTeamLeaderOrAdmin(orgId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedTeamId', 'assignedTeamCode', 'acknowledgedByUid', 'acknowledgedAtMillis', 'deliveryNote', 'updatedAt'])) ||
            // Active responder can acknowledge or mark responding (cannot assign teams, resolve, or close)
            (incoming().status in ['delivered', 'acknowledged', 'responding'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acknowledgedByUid', 'acknowledgedAtMillis', 'deliveryNote', 'updatedAt']))
          );
        allow delete: if false;

        match /audit_logs/{logId} {
          allow get, list: if isOrgMember(orgId);
          allow create: if isActiveResponder(orgId) && isValidId(logId) &&
            incoming().keys().hasAll(['orgId', 'incidentId', 'actorUid', 'fromStatus', 'toStatus', 'note', 'createdAt']) &&
            incoming().keys().hasOnly(['orgId', 'incidentId', 'actorUid', 'fromStatus', 'toStatus', 'note', 'createdAt']) &&
            isValidTimestamp(incoming().createdAt) &&
            isValidSosAuditLog(incoming(), orgId, incidentId);
          allow update, delete: if false;
        }
      }

      // Server-side SOS notification dispatches (written ONLY by Admin SDK / Cloud Functions)
      match /notification_dispatches/{dispatchId} {
        allow get, list: if isOrgMember(orgId);
        allow create, update, delete: if false;
      }

      // Immutable Organization Activity History Timeline
      match /activity_logs/{logId} {
        allow get, list: if isOrgMember(orgId);
        allow create: if isActiveResponder(orgId) && isValidId(logId) &&
          incoming().keys().hasAll(['orgId', 'actorUid', 'actorName', 'category', 'summary', 'targetId', 'createdAt']) &&
          incoming().keys().hasOnly(['orgId', 'actorUid', 'actorName', 'category', 'summary', 'targetId', 'createdAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidActivityLog(incoming(), orgId);
        allow update, delete: if false;
      }

      // Rescue Missions & Team Routing Assignments
      match /missions/{missionId} {
        allow get, list: if isOrgMember(orgId);
        allow create: if isTeamLeaderOrAdmin(orgId) && isValidId(missionId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().keys().hasAll(['missionId', 'orgId', 'title', 'description', 'linkedIncidentId', 'assignedTeamId', 'assignedTeamCode', 'priority', 'status', 'targetLatitude', 'targetLongitude', 'createdByUid', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['missionId', 'orgId', 'title', 'description', 'linkedIncidentId', 'assignedTeamId', 'assignedTeamCode', 'priority', 'status', 'targetLatitude', 'targetLongitude', 'createdByUid', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidMission(incoming(), orgId, missionId);
        allow update: if isActiveResponder(orgId) && isValidId(missionId) &&
          isValidMission(incoming(), orgId, missionId) &&
          incoming().orgId == existing().orgId &&
          incoming().missionId == existing().missionId &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) && (
            isTeamLeaderOrAdmin(orgId) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          );
        allow delete: if isOrgAdmin(orgId) && isValidId(missionId);
      }

      // Blocked Roads & Route Hazard Markers
      match /blocked_roads/{roadId} {
        allow get, list: if isOrgMember(orgId);
        allow create: if isActiveResponder(orgId) && isValidId(roadId) &&
          incoming().reportedByUid == request.auth.uid &&
          incoming().keys().hasAll(['orgId', 'reportedByUid', 'label', 'latitude', 'longitude', 'severity', 'active', 'notes', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['orgId', 'reportedByUid', 'label', 'latitude', 'longitude', 'severity', 'active', 'notes', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isValidBlockedRoad(incoming(), orgId);
        allow update: if isActiveResponder(orgId) && isValidId(roadId) &&
          isValidBlockedRoad(incoming(), orgId) &&
          incoming().orgId == existing().orgId &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['label', 'severity', 'active', 'notes', 'updatedAt']);
        allow delete: if isTeamLeaderOrAdmin(orgId) && isValidId(roadId);
      }

      // Modular UAV / Drone Rescue Telemetry
      match /drone_telemetry/{droneId} {
        allow get, list: if isOrgMember(orgId);
        allow create, update: if isActiveResponder(orgId) && isValidId(droneId) &&
          isValidDroneTelemetry(incoming(), orgId, droneId) &&
          isValidTimestamp(incoming().updatedAt);
        allow delete: if isTeamLeaderOrAdmin(orgId) && isValidId(droneId);
      }
    }
  }
}
