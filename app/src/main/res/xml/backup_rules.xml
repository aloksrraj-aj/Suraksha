<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude offline Room SQLite DB, auth tokens, and local telemetry caches from cloud Auto Backup -->
    <exclude domain="database" path="suraksha_offline_cache.db" />
    <exclude domain="database" path="suraksha_offline_cache.db-shm" />
    <exclude domain="database" path="suraksha_offline_cache.db-wal" />
    <exclude domain="file" path="datastore/suraksha_settings.preferences_pb" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
